<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="16dp"
    android:gravity="center">

    <!-- BARRA DI AVANZAMENTO VERTICALE -->
    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginEnd="8dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_vertical_drawable" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- MENSILE -->
        <TextView
            android:id="@+id/widget_remaining_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3"
            android:text="€..."
            android:textColor="#F2F2F2"
            android:textStyle="bold"
            android:gravity="center_vertical|start"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="32sp"
            android:autoSizeStepGranularity="1sp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="6dp" />

        <!-- OGGI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OGGI"
            android:textColor="#C4C7C5"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_gravity="start" />

        <TextView
            android:id="@+id/widget_daily_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="€..."
            android:textColor="#A8C7FA"
            android:textStyle="bold"
            android:gravity="top|start"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeStepGranularity="1sp" />
    </LinearLayout>

</LinearLayout>
